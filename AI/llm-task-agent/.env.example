# Copy to .env and fill in only what you need to override. Empty = use the default.
# AWS credentials are NOT set here: use `aws configure` / CloudShell / the Lambda role.

# Backend API
API_BASE_URL=https://yu00jk24pk.execute-api.ap-southeast-1.amazonaws.com/api/v1
HTTP_TIMEOUT=30

# Bedrock (us-east-1)
BEDROCK_REGION=us-east-1
BEDROCK_KB_ID=N0NJ2UIEIU
KB_RESULTS=4
# On-demand model IDs only (no "us." / "global." prefix)
PRIMARY_MODEL=amazon.nova-lite-v1:0
FALLBACK_MODEL=qwen.qwen3-next-80b-a3b

# Time used for priority: AGENT_NOW (ISO) wins, else DEMO_DATE at 08:00, else real time
AGENT_NOW=
DEMO_DATE=2026-10-19

# Audit report folder (on Lambda use /tmp/task_agent)
OUTPUT_DIR=output
